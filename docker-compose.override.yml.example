# Example override file for local development
# Copy this to docker-compose.override.yml and customize as needed
# docker-compose.override.yml is automatically loaded by docker-compose

services:
  postgres:
    ports:
      - "5432:5432"
    environment:
      POSTGRES_USER: galaxy_pay_dev
      POSTGRES_PASSWORD: dev_password
      POSTGRES_DB: galaxy_pay_dev

  redis:
    ports:
      - "6379:6379"
    command:
      - redis-server
      - --appendonly yes
      - --maxmemory 256mb
      - --maxmemory-policy allkeys-lru

