## Router Organization

```go
// internal/routes/routes.go
package routes

func Setup(app *fiber.App, container *Container) {
    // Health checks
    app.Get("/health", healthCheck)
    app.Get("/ready", readyCheck)

    // API routes
    api := app.Group("/api")

    // V1 routes
    v1 := api.Group("/v1")
    setupUserRoutes(v1, container.UserHandler)
    setupPaymentRoutes(v1, container.PaymentHandler)

    // V2 routes (future)
    // v2 := api.Group("/v2")
}

func setupUserRoutes(router fiber.Router, h *handler.UserHandler) {
    users := router.Group("/users")
    users.Get("/", h.List)
    users.Get("/:id", h.Get)
    users.Post("/", h.Create)
    users.Put("/:id", h.Update)
    users.Delete("/:id", h.Delete)
}

func setupPaymentRoutes(router fiber.Router, h *handler.PaymentHandler) {
    payments := router.Group("/payments")
    payments.Get("/", h.List)
    payments.Post("/", h.Create)
    payments.Get("/:id", h.Get)
}
```

