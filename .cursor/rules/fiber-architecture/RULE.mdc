## Main Application Setup

```go
package main

import (
    "log"
    "os"

    "github.com/gofiber/fiber/v2"
    "github.com/gofiber/fiber/v2/middleware/logger"
    "github.com/gofiber/fiber/v2/middleware/recover"

    "github.com/devgugga/galaxy-pay/internal/config"
    "github.com/devgugga/galaxy-pay/internal/http/handler"
    "github.com/devgugga/galaxy-pay/internal/service"
    "github.com/devgugga/galaxy-pay/ent"
)

func main() {
    // Load config
    cfg := config.Load()

    // Initialize database
    db := initDB(cfg)

    // Initialize Ent client
    entClient, err := ent.Open("postgres", cfg.DatabaseURL)
    if err != nil {
        log.Fatalf("failed opening connection to database: %v", err)
    }
    defer entClient.Close()

    // Initialize services (now using Ent client directly)
    userService := service.NewUserService(entClient)
    paymentService := service.NewPaymentService(entClient)

    // Initialize handlers
    userHandler := handler.NewUserHandler(userService)
    paymentHandler := handler.NewPaymentHandler(paymentService)

    // Create Fiber app
    app := fiber.New(fiber.Config{
        AppName:      "Galaxy Pay v1.0.0",
        ErrorHandler: customErrorHandler,
    })

    // Setup middleware
    app.Use(recover.New())
    app.Use(logger.New())

    // Setup routes
    setupRoutes(app, userHandler, paymentHandler)

    // Start server
    port := cfg.Port
    log.Printf("Starting server on port %s", port)
    log.Fatal(app.Listen(":" + port))
}

func setupRoutes(
    app *fiber.App,
    userHandler *handler.UserHandler,
    paymentHandler *handler.PaymentHandler,
) {
    // Health checks
    app.Get("/health", healthCheck)
    app.Get("/ready", readyCheck)

    // API routes
    api := app.Group("/api")
    v1 := api.Group("/v1")

    // User routes
    users := v1.Group("/users")
    users.Get("/", userHandler.List)
    users.Get("/:id", userHandler.Get)
    users.Post("/", userHandler.Create)
    users.Put("/:id", userHandler.Update)
    users.Delete("/:id", userHandler.Delete)

    // Payment routes
    payments := v1.Group("/payments")
    payments.Get("/", paymentHandler.List)
    payments.Post("/", paymentHandler.Create)
    payments.Get("/:id", paymentHandler.Get)
}

func customErrorHandler(c *fiber.Ctx, err error) error {
    code := 500
    if e, ok := err.(*fiber.Error); ok {
        code = e.Code
    }

    return c.Status(code).JSON(fiber.Map{
        "error": err.Error(),
    })
}

func healthCheck(c *fiber.Ctx) error {
    return c.JSON(fiber.Map{"status": "healthy"})
}

func readyCheck(c *fiber.Ctx) error {
    return c.JSON(fiber.Map{"status": "ready"})
}
```

