# Fiber Integration with Galaxy Pay Architecture

## Project Structure

```
internal/
├── config/           # Configuration management
├── handlers/         # Fiber handlers (HTTP layer)
├── services/         # Business logic
└── repositories/     # Data access layer
```

---

## Layered Architecture Pattern

**Flow**: Handler → Service → Repository → Database

### Handler Layer (HTTP)

```go
package handlers

import (
    "github.com/gofiber/fiber/v2"
    "github.com/devgugga/galaxy-pay/internal/service"
)

type UserHandler struct {
    userService *service.UserService
}

func NewUserHandler(userService *service.UserService) *UserHandler {
    return &UserHandler{
        userService: userService,
    }
}

func (h *UserHandler) List(c *fiber.Ctx) error {
    users, err := h.userService.ListUsers()
    if err != nil {
        return c.Status(500).JSON(fiber.Map{"error": err.Error()})
    }

    return c.JSON(users)
}

func (h *UserHandler) Get(c *fiber.Ctx) error {
    id := c.Params("id")

    user, err := h.userService.GetUser(id)
    if err != nil {
        return c.Status(404).JSON(fiber.Map{"error": "User not found"})
    }

    return c.JSON(user)
}

func (h *UserHandler) Create(c *fiber.Ctx) error {
    req := new(CreateUserRequest)

    if err := c.BodyParser(req); err != nil {
        return c.Status(400).JSON(fiber.Map{"error": err.Error()})
    }

    user, err := h.userService.CreateUser(req)
    if err != nil {
        return c.Status(400).JSON(fiber.Map{"error": err.Error()})
    }

    return c.Status(201).JSON(user)
}
```

### Service Layer (Business Logic)

```go
package services

import (
    "github.com/devgugga/galaxy-pay/ent"
)

type UserService struct {
    entClient *ent.Client
}

func NewUserService(entClient *ent.Client) *UserService {
    return &UserService{
        entClient: entClient,
    }
}

func (s *UserService) ListUsers() ([]*User, error) {
    return s.entClient.User.Query().All(context.Background())
}

func (s *UserService) GetUser(id string) (*User, error) {
    user, err := s.entClient.User.Query().Where(user.ID(id)).Only(context.Background())
    if err != nil {
        if ent.IsNotFound(err) {
            return nil, ErrUserNotFound
        }
        return nil, err
    }

    return user, nil
}

func (s *UserService) CreateUser(req *CreateUserRequest) (*User, error) {
    // Business logic and validation
    user := &User{
        Name:  req.Name,
        Email: req.Email,
    }

    return s.userRepo.Save(user)
}
```

