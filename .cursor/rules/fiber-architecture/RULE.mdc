## Dependency Injection Pattern

```go
// Container holds all dependencies
type Container struct {
    DB              *sql.DB
    EntClient       *ent.Client
    UserService     *service.UserService
    PaymentService  *service.PaymentService
    UserHandler     *handler.UserHandler
    PaymentHandler  *handler.PaymentHandler
}

func NewContainer(cfg *config.Config) (*Container, error) {
    // Initialize database
    db, err := initDB(cfg)
    if err != nil {
        return nil, err
    }

    // Initialize Ent client
    entClient, err := ent.Open("postgres", cfg.DatabaseURL)
    if err != nil {
        log.Fatalf("failed opening connection to database: %v", err)
    }
    defer entClient.Close()

    // Initialize services (now using Ent client directly)
    userService := service.NewUserService(entClient)
    paymentService := service.NewPaymentService(entClient)

    // Initialize handlers
    userHandler := handler.NewUserHandler(userService)
    paymentHandler := handler.NewPaymentHandler(paymentService)

    return &Container{
        DB:             db,
        UserRepo:       userRepo,
        PaymentRepo:    paymentRepo,
        UserService:    userService,
        PaymentService: paymentService,
        UserHandler:    userHandler,
        PaymentHandler: paymentHandler,
    }, nil
}

func main() {
    cfg := config.Load()

    container, err := NewContainer(cfg)
    if err != nil {
        log.Fatal(err)
    }
    defer container.DB.Close()

    app := fiber.New()

    setupRoutes(app, container.UserHandler, container.PaymentHandler)

    log.Fatal(app.Listen(":" + cfg.Port))
}
```

