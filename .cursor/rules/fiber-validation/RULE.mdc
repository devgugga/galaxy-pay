## Validation Middleware

```go
import "reflect"

func ValidateBody(schema interface{}) fiber.Handler {
    return func(c *fiber.Ctx) error {
        // Create new instance of schema type
        body := reflect.New(reflect.TypeOf(schema)).Interface()

        // Parse body
        if err := c.BodyParser(body); err != nil {
            return c.Status(400).JSON(fiber.Map{
                "error": "Invalid request body",
            })
        }

        // Validate
        errors := xValidator.Validate(body)
        if len(errors) > 0 {
            return c.Status(400).JSON(fiber.Map{
                "error": "Validation failed",
                "details": errors,
            })
        }

        // Store validated body in locals
        c.Locals("validatedBody", body)

        return c.Next()
    }
}

// Usage
app.Post("/payments",
    ValidateBody(CreatePaymentRequest{}),
    func(c *fiber.Ctx) error {
        payment := c.Locals("validatedBody").(*CreatePaymentRequest)
        // Process payment...
        return c.JSON(payment)
    },
)
```

