## Struct Tag Validation

### Common Tags

```go
type User struct {
    // Required
    Name string `json:"name" validate:"required"`

    // String length
    Username string `json:"username" validate:"required,min=3,max=20"`

    // Email
    Email string `json:"email" validate:"required,email"`

    // Numeric constraints
    Age int `json:"age" validate:"required,min=18,max=100"`

    // URL
    Website string `json:"website" validate:"omitempty,url"`

    // Enum
    Role string `json:"role" validate:"required,oneof=admin user guest"`

    // Phone (E.164 format)
    Phone string `json:"phone" validate:"required,e164"`

    // Date
    BirthDate time.Time `json:"birthDate" validate:"required"`
}

type CreatePaymentRequest struct {
    Amount      float64 `json:"amount" validate:"required,gt=0"`
    Currency    string  `json:"currency" validate:"required,iso4217"` // ISO 4217
    Description string  `json:"description" validate:"required,min=5,max=200"`
    CustomerID  string  `json:"customerId" validate:"required,uuid4"`
    Method      string  `json:"method" validate:"required,oneof=credit_card debit_card pix boleto"`
}

type QueryParams struct {
    Page    int      `query:"page" validate:"min=1"`
    Limit   int      `query:"limit" validate:"min=1,max=100"`
    SortBy  string   `query:"sort" validate:"omitempty,oneof=date amount status"`
    OrderBy string   `query:"order" validate:"omitempty,oneof=asc desc"`
    Tags    []string `query:"tags" validate:"omitempty,dive,alphanum"`
}
```

