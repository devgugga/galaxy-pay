## Custom Validation Tags

```go
func init() {
    // Register custom validation for Brazilian CPF
    validate.RegisterValidation("cpf", validateCPF)

    // Register custom validation for strong password
    validate.RegisterValidation("strongpassword", validateStrongPassword)
}

func validateCPF(fl validator.FieldLevel) bool {
    cpf := fl.Field().String()
    // CPF validation logic
    return isValidCPF(cpf)
}

func validateStrongPassword(fl validator.FieldLevel) bool {
    password := fl.Field().String()
    // Must have: min 8 chars, uppercase, lowercase, number, special char
    hasMinLen := len(password) >= 8
    hasUpper := regexp.MustCompile(`[A-Z]`).MatchString(password)
    hasLower := regexp.MustCompile(`[a-z]`).MatchString(password)
    hasNumber := regexp.MustCompile(`[0-9]`).MatchString(password)
    hasSpecial := regexp.MustCompile(`[!@#$%^&*]`).MatchString(password)

    return hasMinLen && hasUpper && hasLower && hasNumber && hasSpecial
}

// Usage
type RegisterRequest struct {
    CPF      string `json:"cpf" validate:"required,cpf"`
    Password string `json:"password" validate:"required,strongpassword"`
}
```

