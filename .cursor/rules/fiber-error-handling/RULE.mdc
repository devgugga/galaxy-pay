## Custom Error Structs

### fiber.NewError

```go
// Simple error with status code
app.Get("/not-found", func(c *fiber.Ctx) error {
    return fiber.NewError(404, "Resource not found")
})

// Error with default message
app.Get("/unavailable", func(c *fiber.Ctx) error {
    return fiber.NewError(503) // Uses "Service Unavailable"
})

// Domain-specific errors
var (
    ErrUserNotFound       = fiber.NewError(404, "User not found")
    ErrInvalidCredentials = fiber.NewError(401, "Invalid credentials")
    ErrInsufficientFunds  = fiber.NewError(400, "Insufficient funds")
    ErrPaymentProcessing  = fiber.NewError(503, "Payment processing failed")
)

app.Post("/login", func(c *fiber.Ctx) error {
    // ...
    if !validCredentials {
        return ErrInvalidCredentials
    }
    // ...
})
```

