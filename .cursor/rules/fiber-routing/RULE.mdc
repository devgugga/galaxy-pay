## Route Grouping

### Basic Grouping

```go
func setupRoutes(app *fiber.App) {
    // API v1 group
    api := app.Group("/api")
    v1 := api.Group("/v1")

    // User routes
    users := v1.Group("/users")
    users.Get("/", listUsers)            // GET /api/v1/users
    users.Get("/:id<int>", getUser)      // GET /api/v1/users/123
    users.Post("/", createUser)           // POST /api/v1/users
    users.Put("/:id<int>", updateUser)    // PUT /api/v1/users/123
    users.Delete("/:id<int>", deleteUser) // DELETE /api/v1/users/123

    // Payment routes with middleware
    payments := v1.Group("/payments", authMiddleware)
    payments.Get("/", listPayments)
    payments.Post("/", processPayment)
    payments.Get("/:id<guid>", getPayment)

    // API v2 group (future)
    v2 := api.Group("/v2")
    v2.Get("/users", listUsersV2)

    // Health checks (outside API versioning)
    app.Get("/health", healthCheck)
    app.Get("/ready", readyCheck)
}
```

