## Content Negotiation

```go
app.Get("/resource", func(c *fiber.Ctx) error {
    // Check what client accepts
    accepts := c.Accepts("json", "xml", "html")

    switch accepts {
    case "json":
        return c.JSON(fiber.Map{"format": "json"})
    case "xml":
        return c.SendString("<format>xml</format>")
    case "html":
        return c.SendString("<h1>HTML</h1>")
    default:
        return c.SendStatus(406) // Not Acceptable
    }
})

// Other accept methods
app.Get("/data", func(c *fiber.Ctx) error {
    charset := c.AcceptsCharsets("utf-8", "iso-8859-1")
    encoding := c.AcceptsEncodings("gzip", "br", "deflate")
    language := c.AcceptsLanguages("en", "pt-BR", "es")

    return c.JSON(fiber.Map{
        "charset":  charset,
        "encoding": encoding,
        "language": language,
    })
})
```

