## Context API - Request Data

### Query Parameters

```go
app.Get("/search", func(c *fiber.Ctx) error {
    // String with default
    query := c.Query("q", "default")

    // Typed methods
    page := c.QueryInt("page", 1)
    limit := c.QueryInt("limit", 10)
    active := c.QueryBool("active", true)
    price := c.QueryFloat("price", 0.0)

    return c.JSON(fiber.Map{
        "query": query,
        "page": page,
        "limit": limit,
        "active": active,
        "price": price,
    })
})
// GET /search?q=fiber&page=2&limit=20&active=false&price=99.99
```

### Route Parameters

```go
app.Get("/user/:id/post/:postId", func(c *fiber.Ctx) error {
    userID := c.Params("id")
    postID := c.Params("postId")

    // With default value
    category := c.Params("category", "general")

    return c.JSON(fiber.Map{
        "userId": userID,
        "postId": postID,
    })
})
```

```go
// Headers (case-insensitive)
authHeader := c.Get("Authorization")
userAgent := c.Get("User-Agent")
contentType := c.Get("Content-Type", "application/json")

// Cookies
sessionID := c.Cookies("session_id")
token := c.Cookies("token", "default-token")

// JSON Body Parser
type User struct {
    Name  string `json:"name"`
    Email string `json:"email"`
    Age   int    `json:"age"`
}

app.Post("/users", func(c *fiber.Ctx) error {
    user := new(User)
    if err := c.BodyParser(user); err != nil {
        return c.Status(400).JSON(fiber.Map{"error": "Cannot parse JSON"})
    }
    return c.Status(201).JSON(user)
})

// Query Parser
type SearchParams struct {
    Query  string   `query:"q"`
    Page   int      `query:"page"`
    Limit  int      `query:"limit"`
}

app.Get("/search", func(c *fiber.Ctx) error {
    params := new(SearchParams)
    if err := c.QueryParser(params); err != nil {
        return c.Status(400).JSON(fiber.Map{"error": err.Error()})
    }
    return c.JSON(params)
})
```

```go
// File Upload
file, err := c.FormFile("document")
if err != nil {
    return c.Status(400).JSON(fiber.Map{"error": "No file uploaded"})
}
c.SaveFile(file, "./uploads/"+file.Filename)

// Multiple Files
form, _ := c.MultipartForm()
files := form.File["documents"]
for _, file := range files {
    c.SaveFile(file, "./uploads/"+file.Filename)
}
```

