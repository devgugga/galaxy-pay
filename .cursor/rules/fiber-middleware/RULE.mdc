## Custom Middleware Patterns

### Basic Structure

```go
func customMiddleware(c *fiber.Ctx) error {
    // Pre-processing (before handler)
    start := time.Now()

    // Call next handler in chain
    err := c.Next()

    // Post-processing (after handler)
    duration := time.Since(start)
    log.Printf("Request took %v", duration)

    return err
}

// Use middleware
app.Use(customMiddleware)
```

### Middleware with Configuration

```go
type Config struct {
    Enabled bool
    Prefix  string
    Filter  func(*fiber.Ctx) bool
}

func CustomMiddleware(config Config) fiber.Handler {
    return func(c *fiber.Ctx) error {
        // Skip if disabled
        if !config.Enabled {
            return c.Next()
        }

        // Skip if filter matches
        if config.Filter != nil && config.Filter(c) {
            return c.Next()
        }

        // Middleware logic
        log.Printf("%s: %s %s", config.Prefix, c.Method(), c.Path())

        return c.Next()
    }
}

// Usage
app.Use(CustomMiddleware(Config{
    Enabled: true,
    Prefix:  "[CUSTOM]",
    Filter: func(c *fiber.Ctx) bool {
        return c.Path() == "/health" // Skip health checks
    },
}))
```

### Authentication Middleware

```go
func AuthRequired(c *fiber.Ctx) error {
    token := c.Get("Authorization")

    if token == "" {
        return c.Status(401).JSON(fiber.Map{
            "error": "Missing authorization token",
        })
    }

    // Verify token
    user, err := verifyToken(token)
    if err != nil {
        return c.Status(401).JSON(fiber.Map{
            "error": "Invalid token",
        })
    }

    // Store user in context
    c.Locals("user", user)

    return c.Next()
}

// Usage - Protect specific routes
app.Get("/public", publicHandler)
app.Get("/private", AuthRequired, privateHandler)

// Usage - Protect route group
admin := app.Group("/admin", AuthRequired)
admin.Get("/users", listUsers)
admin.Delete("/users/:id", deleteUser)
```

### Role-Based Access Control

```go
func RequireRole(roles ...string) fiber.Handler {
    return func(c *fiber.Ctx) error {
        user, ok := c.Locals("user").(*User)
        if !ok {
            return c.Status(500).SendString("Internal error")
        }

        // Check if user has required role
        hasRole := false
        for _, role := range roles {
            if user.Role == role {
                hasRole = true
                break
            }
        }

        if !hasRole {
            return c.Status(403).JSON(fiber.Map{
                "error": "Insufficient permissions",
            })
        }

        return c.Next()
    }
}

// Usage
app.Delete("/users/:id",
    AuthRequired,
    RequireRole("admin", "moderator"),
    deleteUser,
)
```

