## Memory Management Best Practices

### DO ✅

```go
// Copy context values before goroutines
app.Get("/async", func(c *fiber.Ctx) error {
    data := utils.CopyString(c.Query("data"))

    go processAsync(data) // ✅ Safe

    return c.SendString("Processing")
})
```

```go
// Parse request body once, reuse struct
app.Post("/user", func(c *fiber.Ctx) error {
    user := new(User)

    if err := c.BodyParser(user); err != nil {
        return err
    }

    // Use parsed user multiple times
    if err := validate(user); err != nil {
        return err
    }

    saveUser(user)
    return c.JSON(user)
})
```

```go
// Use c.Locals() for request-scoped data
func middleware(c *fiber.Ctx) error {
    c.Locals("startTime", time.Now())
    return c.Next()
}

func handler(c *fiber.Ctx) error {
    start := c.Locals("startTime").(time.Time)
    duration := time.Since(start)
    // ...
}
```

### DON'T ❌

```go
// ❌ Don't store context values globally
var globalData string
app.Get("/", func(c *fiber.Ctx) error {
    globalData = c.Query("data") // WRONG!
    return c.SendString("OK")
})
```

```go
// ❌ Don't pass context values to goroutines without copying
app.Get("/", func(c *fiber.Ctx) error {
    name := c.Params("name")

    go func() {
        time.Sleep(1 * time.Second)
        log.Println(name) // WRONG! May be corrupted
    }()

    return c.SendString("OK")
})
```

```go
// ❌ Don't parse body multiple times
app.Post("/", func(c *fiber.Ctx) error {
    var user1 User
    c.BodyParser(&user1) // Parsed once

    var user2 User
    c.BodyParser(&user2) // Inefficient! Use user1

    return c.JSON(user1)
})
```

```go
// ❌ Don't use Immutable: true in production without benchmarking
app := fiber.New(fiber.Config{
    Immutable: true, // CAREFUL! Performance cost
})
```

