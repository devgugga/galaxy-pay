## OnGroup & OnGroupName Hooks

```go
app.Hooks().OnGroup(func(g fiber.Group) error {
    log.Printf("Group registered: %s", g.Prefix)
    return nil
})

app.Hooks().OnGroupName(func(g fiber.Group) error {
    log.Printf("Group named: %s -> %s", g.Prefix, g.Name)
    return nil
})

// Define groups
api := app.Group("/api")
v1 := api.Group("/v1").Name("api.v1")
v2 := api.Group("/v2").Name("api.v2")
```

