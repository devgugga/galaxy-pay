## OnRoute & OnName Hooks

### Route Registration Tracking

```go
func main() {
    app := fiber.New()

    // Track all route registrations
    app.Hooks().OnRoute(func(r fiber.Route) error {
        log.Printf("Registered route: %s %s -> %s",
            r.Method,
            r.Path,
            r.Name,
        )
        return nil
    })

    // Enforce naming conventions
    app.Hooks().OnName(func(r fiber.Route) error {
        if !strings.HasPrefix(r.Name, "api.") {
            log.Printf("Warning: Route %s doesn't follow naming convention", r.Name)
        }
        return nil
    })

    // Define routes
    app.Get("/users", getUsers).Name("api.users.list")
    app.Get("/users/:id", getUser).Name("api.users.get")
    app.Post("/users", createUser).Name("api.users.create")

    app.Listen(":8080")
}
```

