## Integration Testing

```go
func TestPaymentFlow(t *testing.T) {
    // Setup test database
    db := setupTestDB()
    defer db.Close()

    // Create app
    app := setupApp(db)

    // Step 1: Create user
    userData := map[string]string{
        "name":  "Test User",
        "email": "test@example.com",
    }
    userJSON, _ := json.Marshal(userData)

    req := httptest.NewRequest("POST", "/users", bytes.NewReader(userJSON))
    req.Header.Set("Content-Type", "application/json")

    resp, _ := app.Test(req)
    assert.Equal(t, 201, resp.StatusCode)

    var user map[string]interface{}
    json.NewDecoder(resp.Body).Decode(&user)
    userID := user["id"].(string)

    // Step 2: Create payment
    paymentData := map[string]interface{}{
        "userId": userID,
        "amount": 100.00,
        "method": "credit_card",
    }
    paymentJSON, _ := json.Marshal(paymentData)

    req = httptest.NewRequest("POST", "/payments", bytes.NewReader(paymentJSON))
    req.Header.Set("Content-Type", "application/json")

    resp, _ = app.Test(req)
    assert.Equal(t, 201, resp.StatusCode)

    // Step 3: Verify payment in database
    var payment Payment
    db.First(&payment, "user_id = ?", userID)
    assert.Equal(t, 100.00, payment.Amount)
}
```

