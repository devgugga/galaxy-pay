# Application Configuration
APP_NAME=Galaxy Pay
APP_VERSION=1.0.0
APP_ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8080

# Server Timeouts (in seconds)
READ_TIMEOUT=15
WRITE_TIMEOUT=15
IDLE_TIMEOUT=60

# Body Limit (in MB)
BODY_LIMIT_MB=4

# Logging Configuration
LOG_LEVEL=info

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# Rate Limiting Configuration
RATE_LIMIT_MAX=100
RATE_LIMIT_DURATION=60
